# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: pre-fills the email field on the admin sign-in screen (Ctrl+Shift+A).
# This is only a convenience — real protection comes from Supabase Auth + RLS.
VITE_ADMIN_EMAIL=admin@uicnavigators.org

# Email (RSVP confirmations + event-update / removal notifications) is sent by
# the Supabase Edge Function `supabase/functions/send-email`, which calls Resend
# server-side. There are NO email keys in the browser — configure them as
# Supabase secrets instead (Edge Functions → Manage secrets):
#   RESEND_API_KEY   — from https://resend.com/api-keys
#   RESEND_FROM      — e.g. "Navigators at UIC <hello@your-domain.org>"
# See supabase/functions/send-email/index.ts for deploy steps. If email isn't
# set up, the app still works — RSVPs just confirm instantly instead.
