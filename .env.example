# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: pre-fills the email field on the admin sign-in screen (Ctrl+Shift+A).
# This is only a convenience — real protection comes from Supabase Auth + RLS.
VITE_ADMIN_EMAIL=admin@uicnavigators.org

# EmailJS (RSVP confirmations + event-update / removal notifications).
# Create a free account at https://www.emailjs.com, add an email service and a
# template, then paste the IDs below. The public key is safe to expose — lock
# sending down by allowlisting your site's domain in the EmailJS dashboard.
# Your template must use these variables:
#   {{to_email}}  {{to_name}}  {{subject}}  {{title}}  {{message}}
# and set the template's "To email" field to {{to_email}}.
# If these are left blank, the app still works — emails just don't send.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
