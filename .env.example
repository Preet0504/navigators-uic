# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: pre-fills the email field on the admin sign-in screen (Ctrl+Shift+A).
# This is only a convenience — real protection comes from Supabase Auth + RLS.
VITE_ADMIN_EMAIL=admin@uicnavigators.org
